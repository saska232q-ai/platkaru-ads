<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PlatkaRu - Рекламная Биржа</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg-color: var(--tg-theme-bg-color, #ffffff);
            --text-color: var(--tg-theme-text-color, #000000);
            --hint-color: var(--tg-theme-hint-color, #999999);
            --button-color: var(--tg-theme-button-color, #2481cc);
            --button-text: var(--tg-theme-button-text-color, #ffffff);
            --secondary-bg: var(--tg-theme-secondary-bg-color, #f0f0f0);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 15px;
            -webkit-user-select: none;
        }

        .header {
            text-align: center;
            padding: 20px 0;
        }

        .header h1 { margin: 0; font-size: 22px; }
        .header p { color: var(--hint-color); font-size: 14px; margin-top: 5px; }

        .category-title {
            font-weight: bold;
            margin: 20px 0 10px;
            font-size: 18px;
            border-left: 4px solid var(--button-color);
            padding-left: 10px;
        }

        .card {
            background-color: var(--secondary-bg);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .card h3 { margin: 0; font-size: 17px; display: flex; align-items: center; gap: 8px; }
        .card-info { color: var(--hint-color); font-size: 13px; }
        .price-row { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
        .price { font-size: 18px; font-weight: bold; color: #31b545; }

        .btn {
            background-color: var(--button-color);
            color: var(--button-text);
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            font-size: 14px;
        }

        .btn:active { opacity: 0.8; }

        .footer {
            text-align: center;
            font-size: 12px;
            color: var(--hint-color);
            margin-top: 30px;
            padding-bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>PlatkaRu Реклама</h1>
        <p>Лучшие площадки для вашего роста</p>
    </div>

    <div class="category-title">😂 Юмор и развлечения</div>

    <div class="card">
        <h3>🚀 Смейся До Слез</h3>
        <div class="card-info">Подписчиков: 12,400 • Охват: 4,500</div>
        <div class="price-row">
            <div class="price">850 ₽</div>
            <button class="btn" onclick="order('Смейся До Слез')">Заказать</button>
        </div>
    </div>

    <div class="category-title">💰 Бизнес и Крипта</div>

    <div class="card">
        <h3>💎 Crypto Whale</h3>
        <div class="card-info">Подписчиков: 5,200 • Охват: 2,100</div>
        <div class="price-row">
            <div class="price">1,500 ₽</div>
            <button class="btn" onclick="order('Crypto Whale')">Заказать</button>
        </div>
    </div>

    <div class="footer">
        © 2024 PlatkaRu. Все сделки защищены.
    </div>

    <script>
        function order(channelName) {
            const adminUsername = "Hshsb821"; 
            const message = "Здравствуйте! Хочу заказать рекламу в канале: " + channelName;
            const url = "https://t.me/" + adminUsername + "?text=" + encodeURIComponent(message);
            window.location.href = url;
        }
    </script>

</body>
</html>
